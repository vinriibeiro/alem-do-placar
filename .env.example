# Modelo de variáveis de ambiente. Copie para .env e preencha apenas localmente.
# Nunca versione o arquivo .env nem cole credenciais reais neste modelo.
APP_ENV=development
LOG_LEVEL=INFO
# Credencial do assistente (T009). Mantenha vazia até a integração ser aprovada.
LLM_API_KEY=

# Assistente v2 (opcionais; padrões seguros). Defina somente localmente ou no provedor de hospedagem.
# LLM_MODEL=claude-opus-5-5
# LLM_DAILY_LIMIT=500
# RATE_LIMIT_PER_MIN=20
# ALLOWED_HOSTS=seu-dominio.com
# ALLOWED_ORIGINS=https://seu-dominio.com
# POWERBI_EMBED_URL=
# TRUST_PROXY=true
# REPO_URL=https://github.com/usuario/alem-do-placar
