	partition fato_desempenho_equipes = m
		mode: import
		source =
				let
				    Origem = Parquet.Document(File.Contents("C:\Users\Vinícius Ribeiro\Documents\Projetos\Além do Placar\data\processed\fato_desempenho_equipes.parquet")),
				    Resultado = Table.AddColumn(Origem, "resultado_equipe", each if [pontos] = 3 then "Vitória" else if [pontos] = 1 then "Empate" else "Derrota", type text)
				in
				    Resultado

