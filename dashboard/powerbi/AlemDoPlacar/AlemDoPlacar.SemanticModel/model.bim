      },
      {
        "name": "fato_desempenho_equipes",
        "columns": [
          {
            "name": "partida_id",
            "dataType": "string",
            "sourceColumn": "partida_id",
            "summarizeBy": "none"
          },
          {
            "name": "equipe_id",
            "dataType": "int64",
            "sourceColumn": "equipe_id",
            "summarizeBy": "none"
          },
          {
            "name": "pontos",
            "dataType": "int64",
            "sourceColumn": "pontos",
            "summarizeBy": "none"
          },
          {
            "name": "gols_pro",
            "dataType": "int64",
            "sourceColumn": "gols_pro",
            "summarizeBy": "none"
          },
          {
            "name": "gols_contra",
            "dataType": "int64",
            "sourceColumn": "gols_contra",
            "summarizeBy": "none"
          },
          {
            "name": "saldo_gols",
            "dataType": "int64",
            "sourceColumn": "saldo_gols",
            "summarizeBy": "none"
          },
          {
            "name": "mando_campo",
            "dataType": "string",
            "sourceColumn": "mando_campo",
            "summarizeBy": "none"
          },
          {
            "name": "rodada",
            "dataType": "int64",
            "sourceColumn": "rodada",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fato_desempenho_equipes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origem = Parquet.Document(File.Contents(\"C:\\Users\\Vinícius Ribeiro\\Documents\\Projetos\\Além do Placar\\data\\processed\\fato_desempenho_equipes.parquet\"))",
                "in",
                "    Origem"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Modelo selecionado",
            "expression": "\"M01_ridge\""
          },
          {
            "name": "Corte de treino",
            "expression": "\"2025-03-29\""
          },
          {
            "name": "Versão do modelo",
            "expression": "\"T006-1.0\""
          },
          {
            "name": "Notas do modelo",
            "expression": "\"ganho mínimo de 2% no MAE médio e piora anual até 10%\""
          },
          {
            "name": "Cobertura do intervalo",
            "expression": "0.9121212121212121",
            "formatString": "0.0%"
          },
          {
            "name": "Partidas",
            "expression": "DISTINCTCOUNT(fato_desempenho_equipes[partida_id])",
            "formatString": "#,0"
          },
          {
            "name": "Temporadas",
            "expression": "DISTINCTCOUNT(dim_temporadas[ano])",
            "formatString": "0"
          },
          {
            "name": "Observações de equipe",
            "expression": "COUNTROWS(fato_desempenho_equipes)",
            "formatString": "#,0"
          },
          {
            "name": "Gols",
            "expression": "SUM(fato_desempenho_equipes[gols_pro])",
            "formatString": "#,0"
          },
          {
            "name": "Gols sofridos",
            "expression": "SUM(fato_desempenho_equipes[gols_contra])",
            "formatString": "#,0"
          },
          {
            "name": "Saldo de gols",
            "expression": "SUM(fato_desempenho_equipes[saldo_gols])",
            "formatString": "+#,0;-#,0;0"
          },
          {
            "name": "Pontos totais",
            "expression": "SUM(fato_desempenho_equipes[pontos])",
            "formatString": "#,0"
          },
          {
            "name": "Vitórias",
            "expression": "CALCULATE(COUNTROWS(fato_desempenho_equipes),fato_desempenho_equipes[pontos]=3)",
            "formatString": "#,0"
          },
          {
            "name": "Empates",
            "expression": "CALCULATE(COUNTROWS(fato_desempenho_equipes),fato_desempenho_equipes[pontos]=1)",
            "formatString": "#,0"
          },
          {
            "name": "Derrotas",
            "expression": "CALCULATE(COUNTROWS(fato_desempenho_equipes),fato_desempenho_equipes[pontos]=0)",
            "formatString": "#,0"
          },
          {
            "name": "Gols por jogo",
            "expression": "DIVIDE([Gols],[Partidas])",
            "formatString": "0.00"
          },
          {
            "name": "Gols sofridos por jogo",
            "expression": "DIVIDE([Gols sofridos],[Observações de equipe])",
            "formatString": "0.00"
          },
          {
            "name": "Pontos por jogo",
            "expression": "DIVIDE([Pontos totais],[Observações de equipe])",
            "formatString": "0.00"
          },
          {
            "name": "Aproveitamento",
            "expression": "DIVIDE([Pontos totais],3*[Observações de equipe])",
            "formatString": "0.0%"
          },
          {
            "name": "Vitórias do mandante",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(fato_desempenho_equipes),fato_desempenho_equipes[mando_campo]=\"mandante\",fato_desempenho_equipes[pontos]=3),CALCULATE(COUNTROWS(fato_desempenho_equipes),fato_desempenho_equipes[mando_campo]=\"mandante\"))",
            "formatString": "0.0%"
          },
          {
            "name": "Volatilidade de pontos",
            "expression": "STDEV.P(fato_desempenho_equipes[pontos])",
            "formatString": "0.00"
          },
          {
            "name": "Posição",
            "expression": "IF(ISINSCOPE(dim_equipes[nome_padronizado]),RANKX(ALL(dim_equipes[nome_padronizado]),[Pontos totais],,DESC,Dense))",
            "formatString": "0"
          },
          {
            "name": "Média prevista",
            "expression": "AVERAGE(previsoes[previsao])",
            "formatString": "0.00"
          },
          {
            "name": "Média observada",
            "expression": "AVERAGE(previsoes[alvo])",
            "formatString": "0.00"
          },
          {
            "name": "Limite inferior",
            "expression": "AVERAGE(previsoes[limite_inferior])",
            "formatString": "0.00"
          },
          {
            "name": "Limite superior",
            "expression": "AVERAGE(previsoes[limite_superior])",
            "formatString": "0.00"
          },
          {
            "name": "Erro absoluto médio",
            "expression": "AVERAGEX(previsoes,ABS(previsoes[previsao]-previsoes[alvo]))",
            "formatString": "0.000"
          },
          {
            "name": "Média 3 jogos",
            "expression": "AVERAGE(analitico[media_pontos_3])",
            "formatString": "0.00"
          },
          {
            "name": "Média recente",
            "expression": "AVERAGE(analitico[media_pontos_5])",
            "formatString": "0.00"
          },
          {
            "name": "Média 10 jogos",
            "expression": "AVERAGE(analitico[media_pontos_10])",
            "formatString": "0.00"
          },
          {
            "name": "Importância",
            "expression": "AVERAGE(importancias[delta_mae_media])",
            "formatString": "0.0000"
          },
          {
            "name": "MAE global selecionado",
            "expression": "VAR ModeloAtual = [Modelo selecionado] RETURN CALCULATE(MAX(metricas[mae]),metricas[fase]=\"holdout\",metricas[modelo]=ModeloAtual,metricas[temporada]=\"todas\")",
            "formatString": "0.000"
          },
          {
            "name": "MAE global baseline",
            "expression": "CALCULATE(MAX(metricas[mae]),metricas[fase]=\"holdout\",metricas[modelo]=\"M00_media_recente_5\",metricas[temporada]=\"todas\")",
            "formatString": "0.000"
          },
          {
            "name": "MAE validação",
            "expression": "CALCULATE(MAX(metricas[mae]),metricas[fase]=\"validacao\",metricas[temporada]=\"todas\")",
            "formatString": "0.000"
          },
          {
            "name": "MAE holdout",
            "expression": "CALCULATE(MAX(metricas[mae]),metricas[fase]=\"holdout\",metricas[temporada]=\"todas\")",
            "formatString": "0.000"
          },
          {
            "name": "RMSE validação",
            "expression": "CALCULATE(MAX(metricas[rmse]),metricas[fase]=\"validacao\",metricas[temporada]=\"todas\")",
            "formatString": "0.000"
          },
          {
            "name": "RMSE holdout",
            "expression": "CALCULATE(MAX(metricas[rmse]),metricas[fase]=\"holdout\",metricas[temporada]=\"todas\")",
            "formatString": "0.000"
          }
        ]
      },
