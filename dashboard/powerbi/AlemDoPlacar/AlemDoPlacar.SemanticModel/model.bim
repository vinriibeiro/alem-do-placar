        "partitions": [
          {
            "name": "dim_equipes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origem = Parquet.Document(File.Contents(\"C:\\Users\\Vinícius Ribeiro\\Documents\\Projetos\\Além do Placar\\data\\processed\\dim_equipes.parquet\")),",
                "    Escudos = Table.FromRecords({[equipe = \"América Mineiro\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Am%C3%A9rica_Futebol_Clube_%28Belo_Horizonte%2C_Minas_Gerais%29_logo.svg/120px-Am%C3%A9rica_Futebol_Clube_%28Belo_Horizonte%2C_Minas_Gerais%29_logo.svg.png\"], [equipe = \"Athletico Paranaense\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Athletico_Paranaense_%28Logo_2019%29.svg/120px-Athletico_Paranaense_%28Logo_2019%29.svg.png\"], [equipe = \"Atlético Goianiense\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Atl%C3%A9tico_Goianiense_logo_%28sem_estrelas%29.png/120px-Atl%C3%A9tico_Goianiense_logo_%28sem_estrelas%29.png\"], [equipe = \"Atlético Mineiro\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/27/Clube_Atl%C3%A9tico_Mineiro_logo.svg/120px-Clube_Atl%C3%A9tico_Mineiro_logo.svg.png\"], [equipe = \"Avaí SC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Ava%C3%AD_Futebol_Clube_logo.svg/120px-Ava%C3%AD_Futebol_Clube_logo.svg.png\"], [equipe = \"Botafogo FR\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/Botafogo_de_Futebol_e_Regatas_logo.svg/120px-Botafogo_de_Futebol_e_Regatas_logo.svg.png\"], [equipe = \"CR Vasco da Gama\", escudo = \"https://thumb.wikimedia.org/wikipedia/pt/thumb/8/8b/EscudoDoVascoDaGama.svg/120px-EscudoDoVascoDaGama.svg.png\"], [equipe = \"CSA AL\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Centro_Sportivo_Alagoano_logo.png/120px-Centro_Sportivo_Alagoano_logo.png\"], [equipe = \"Ceará SC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Cear%C3%A1_Sporting_Club_logo.svg/120px-Cear%C3%A1_Sporting_Club_logo.svg.png\"], [equipe = \"Chapecoense\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4e/Logo_Associa%C3%A7%C3%A3o_Chapecoense_de_Futebol.svg/120px-Logo_Associa%C3%A7%C3%A3o_Chapecoense_de_Futebol.svg.png\"], [equipe = \"Coritiba FBC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Coritiba_Foot_Ball_Club_logo.svg/120px-Coritiba_Foot_Ball_Club_logo.svg.png\"], [equipe = \"Criciúma EC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9b/Crici%C3%BAma_EC_2025_crest.svg/120px-Crici%C3%BAma_EC_2025_crest.svg.png\"], [equipe = \"Cruzeiro EC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Cruzeiro_Esporte_Clube_%28logo%29.svg/120px-Cruzeiro_Esporte_Clube_%28logo%29.svg.png\"], [equipe = \"Cuiabá EC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Cuiab%C3%A1_Esporte_Clube.svg/120px-Cuiab%C3%A1_Esporte_Clube.svg.png\"], [equipe = \"EC Bahia\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2c/Esporte_Clube_Bahia_logo.svg/120px-Esporte_Clube_Bahia_logo.svg.png\"], [equipe = \"EC Juventude\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2d/Esporte_Clube_Juventude_logo.svg/120px-Esporte_Clube_Juventude_logo.svg.png\"], [equipe = \"EC Vitória\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/Esporte_Clube_Vit%C3%B3ria_%282024%29.svg/120px-Esporte_Clube_Vit%C3%B3ria_%282024%29.svg.png\"], [equipe = \"Flamengo\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Clube_de_Regatas_do_Flamengo_logo.svg/120px-Clube_de_Regatas_do_Flamengo_logo.svg.png\"], [equipe = \"Fluminense FC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Fluminense_Football_Club.svg/120px-Fluminense_Football_Club.svg.png\"], [equipe = \"Fortaleza EC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3d/Fortaleza_Esporte_Clube_logo.svg/120px-Fortaleza_Esporte_Clube_logo.svg.png\"], [equipe = \"Goiás EC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4a/Goi%C3%A1s_Esporte_Clube_logo.svg/120px-Goi%C3%A1s_Esporte_Clube_logo.svg.png\"], [equipe = \"Grêmio\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Gremio_logo.svg/120px-Gremio_logo.svg.png\"], [equipe = \"Mirassol FC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fd/Mirassol_Futebol_Clube_logo_%283_stars%29.png/120px-Mirassol_Futebol_Clube_logo_%283_stars%29.png\"], [equipe = \"Paraná Clube\", escudo = \"https://thumb.wikimedia.org/wikipedia/pt/thumb/9/9f/Paran%C3%A1_Clube_logo.png/120px-Paran%C3%A1_Clube_logo.png\"], [equipe = \"RB Bragantino\", escudo = \"https://thumb.wikimedia.org/wikipedia/pt/thumb/9/9e/RedBullBragantino.png/120px-RedBullBragantino.png\"], [equipe = \"SC Corinthians Paulista\", escudo = \"https://thumb.wikimedia.org/wikipedia/pt/thumb/b/b4/Corinthians_simbolo.png/120px-Corinthians_simbolo.png\"], [equipe = \"SC Internacional\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/Sport_Club_Internacional_logo.svg/120px-Sport_Club_Internacional_logo.svg.png\"], [equipe = \"SC Recife\", escudo = \"https://thumb.wikimedia.org/wikipedia/pt/thumb/1/1a/Sport-clube-recife.svg/120px-Sport-clube-recife.svg.png\"], [equipe = \"SE Palmeiras\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/Sociedade_Esportiva_Palmeiras_logo_%281_red_star%29.svg/120px-Sociedade_Esportiva_Palmeiras_logo_%281_red_star%29.svg.png\"], [equipe = \"Santos FC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0e/Santos_Futebol_Clube_logo_%28with_stars_and_crown%29.png/120px-Santos_Futebol_Clube_logo_%28with_stars_and_crown%29.png\"], [equipe = \"São Paulo FC\", escudo = \"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f4/S%C3%A3o_Paulo_Futebol_Clube_logo_%282022%29.svg/120px-S%C3%A3o_Paulo_Futebol_Clube_logo_%282022%29.svg.png\"]}, type table [equipe = text, escudo = text]),",
                "    Unido = Table.NestedJoin(Origem, {\"nome_padronizado\"}, Escudos, {\"equipe\"}, \"esc\", JoinKind.LeftOuter),",
                "    Final = Table.ExpandTableColumn(Unido, \"esc\", {\"escudo\"})",
                "in",
                "    Final"
              ]
            }
          }
        ],
        "measures": []
      },
